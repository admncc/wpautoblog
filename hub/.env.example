# --- Autoblog Hub: Konfiguration -------------------------------------------
# Diese Datei nach ".env" kopieren und anpassen.

# Adresse, unter der der Hub im Netz erreichbar ist.
# Genau diese Adresse wird im WordPress-Plugin als "Hub-Adresse" eingetragen.
PUBLIC_URL=https://autoblog.meinedomain.de

# Port, auf dem der Server lauscht.
PORT=4000

# Anthropic API-Key. Kann alternativ in der Oberflaeche unter "Einstellungen"
# hinterlegt werden - der dort eingetragene Key hat Vorrang.
# ANTHROPIC_API_KEY=sk-ant-...

# Standardmodell (in der Oberflaeche umstellbar):
# claude-opus-5 (beste Qualitaet) | claude-sonnet-5 | claude-haiku-4-5
DEFAULT_MODEL=claude-opus-5

# Schluessel zum Verschluesseln gespeicherter Zugangsdaten und zum Signieren der
# Anmelde-Cookies. Wird beim ersten Start automatisch erzeugt (data/.app_secret).
# Bei einem Serverumzug unbedingt mitnehmen, sonst sind gespeicherte Keys unlesbar.
# APP_SECRET=

# Ablageort fuer Datenbank und Schluessel.
# DATA_DIR=./data
